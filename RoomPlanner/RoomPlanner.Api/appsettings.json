{
  "ConnectionStrings": {
    "Default": "Data Source=roomplanner.db;Foreign Keys=True"
  },
  "Seeding": {
    "Enabled": true,
    "Reservations": 500
  },
  "Cors": {
    "Origins": [ "http://localhost:5862" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/RoomPlanner-.log",
          "restrictedToMinimumLevel": "Information",
          "rollingInterval": "Month",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 12
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
