{
  "Urls": "http://localhost:5841",
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/helpdesk.db;Foreign Keys=True"
  },
  "Storage": {
    "AttachmentsFolder": "App_Data/uploads"
  },
  "Authentication": {
    "Jwt": {
      "Secret": "REPLACE-IN-USER-SECRETS-OR-ENVIRONMENT-WITH-A-RANDOM-SECRET-OF-AT-LEAST-64-CHARACTERS",
      "Authority": "helpdesk-api",
      "Audience": "helpdesk-spa",
      "LifeSpan": 28800
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/HelpDesk.Api-.log",
          "restrictedToMinimumLevel": "Information",
          "rollingInterval": "Month",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 12
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
