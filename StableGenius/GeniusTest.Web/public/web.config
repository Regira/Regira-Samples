<?xml version="1.0" encoding="utf-8"?>
<!--
    IIS config for the SPA (copied into dist/ by the build). Requires the IIS URL Rewrite module.

    Deployment layout:
        StableGenius\client  <- this SPA (dist\)     virtual directory /stablegenius/play
        StableGenius\api     <- GeniusTest.Api       IIS application   /stablegenius/api
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- deep links (/stablegenius/play/play/..., /stablegenius/play/admin/...) serve index.html so a refresh works -->
                <rule name="StableGenius SPA fallback" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.html" />
                </rule>
            </rules>
        </rewrite>
        <staticContent>
            <!-- index.html (also served for deep links), config.json and data/*: always revalidate (a 304 when unchanged),
                 so a redeploy shows up without a hard refresh -->
            <clientCache cacheControlMode="DisableCache" />
            <!-- the app fetches config.json and data/*.json|csv at startup -->
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <remove fileExtension=".csv" />
            <mimeMap fileExtension=".csv" mimeType="text/csv" />
            <remove fileExtension=".woff" />
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        </staticContent>
    </system.webServer>
    <!-- the build's hashed files never change under the same name: cache them for a year -->
    <location path="assets">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
