{
  "ConnectionStrings": {
    "Default": "Data Source=qcredits.db;Foreign Keys=True"
  },
  "Authentication": {
    "Jwt": {
      "Secret": "QCredits-dev-secret-6c1f0e2a9b7d4c3e8f5a1b2c3d4e5f60718293a4b5c6d7e8f9012345678abcdef",
      "Authority": "qcredits-api",
      "Audience": "qcredits-spa",
      "LifeSpan": 28800
    }
  },
  "Cors": {
    "Origins": [ "http://localhost:5852" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/QCredits-.log",
          "restrictedToMinimumLevel": "Information",
          "rollingInterval": "Month",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 12
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
