<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fleet.API</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Regira Entities framework -->
    <PackageReference Include="Regira.Entities.DependencyInjection" Version="6.0.0" />
    <PackageReference Include="Regira.Entities.EFcore" Version="6.0.0" />
    <PackageReference Include="Regira.Entities.Web" Version="6.0.0" />
    <PackageReference Include="Regira.Entities.Mapping.Mapster" Version="6.0.0" />

    <!-- EF Core provider (SQLite, disposable dev database) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />

    <!-- OpenAPI + Scalar API reference UI -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="*" />

    <!-- Structured logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="*" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="*" />
    <PackageReference Include="Serilog.Sinks.File" Version="*" />

    <!-- Fake data generation for seeding -->
    <PackageReference Include="Bogus" Version="35.6.1" />
  </ItemGroup>

</Project>
