{
  "ConnectionStrings": {
    "Default": "Data Source=eventplanner.db;Foreign Keys=True"
  },
  "Authentication": {
    "Jwt": {
      "Secret": "EventPlanner-dev-only-secret-7f3c9a1e5b2d4f6a8c0e1b3d5f7a9c2e4b6d8f0a1c3e5b7d9f2a4c6e8b0d1f3a5c7",
      "Authority": "EventPlanner.Api",
      "Audience": "eventplanner-spa",
      "LifeSpan": 7200
    }
  },
  "Seed": {
    "Events": 500
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/EventPlanner.Api-.log",
          "restrictedToMinimumLevel": "Information",
          "rollingInterval": "Month",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 12
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
